[Unit]
Description=VintedAutomate agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vintedautomate
WorkingDirectory=/opt/vintedautomate
EnvironmentFile=/opt/vintedautomate/.env
ExecStart=/opt/vintedautomate/.venv/bin/python scripts/run_agent.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
